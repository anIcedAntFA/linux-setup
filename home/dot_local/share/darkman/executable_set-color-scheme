#!/bin/sh
# darkman transition hook. darkman runs it on BOTH the sunrise/sunset schedule and
# a manual `darkman toggle`, passing the new mode ("dark" | "light") as $1.
#
# We mirror that mode into the gnome color-scheme gsetting. The gtk XDG portal
# (Settings=gtk) then broadcasts it to every portal-aware app (VS Code
# autoDetect, Ghostty, Chrome), and fish's auto-sync-theme reads the same key.
# This is the single point that turns "darkman's mode" into "what apps see".
# See docs/theme-sync.md.
set -eu

case "$1" in
dark) scheme=prefer-dark ;;
light) scheme=prefer-light ;;
*)
	echo "set-color-scheme: unknown mode '$1'" >&2
	exit 1
	;;
esac

gsettings set org.gnome.desktop.interface color-scheme "$scheme"

# Zed has no native per-color-scheme font weight, so we swap it here: 200
# (ExtraLight) in dark, 400 in light. Zed watches settings.json by INODE, so we
# must edit it IN PLACE (truncate + rewrite the same inode). Plain `sed -i` does
# an atomic rename to a NEW inode, which silently breaks Zed's watch — edits then
# go unnoticed until Zed is restarted or its settings UI forces a re-read. sed
# (not jq) because the file is JSONC (comments + trailing commas).
# chezmoi's source keeps the 400 light baseline, so a `chezmoi apply` while in
# dark mode reverts the weight to 400 until the next toggle — an accepted
# trade-off. See docs/adr/0013-zed-per-theme-font-weight-via-darkman-hook.md.
zed_settings="${XDG_CONFIG_HOME:-$HOME/.config}/zed/settings.json"
case "$1" in
dark) weight=200 ;;
*) weight=400 ;;
esac
if [ -f "$zed_settings" ]; then
	tmp=$(mktemp)
	sed -E "s/(\"buffer_font_weight\": )[0-9]+(\.[0-9]+)?/\1$weight/" "$zed_settings" >"$tmp"
	cat "$tmp" >"$zed_settings" # truncate-rewrite: keeps the inode Zed is watching
	rm -f "$tmp"
fi
