#!/bin/sh
# Ordered, output-gated autostart for apps whose niri workspace is pinned to a
# monitor that may not be ready the instant spawn-at-startup fires. See
# docs/niri-config.md.
#
#   dot-niri-startup <output> <cmd> [<cmd> ...]
#
# Why this exists: apps launched at login can race niri's output/workspace setup.
# The `open-on-workspace` window-rules route each app to its pinned named
# workspace, and each named workspace is pinned to <output> via `open-on-output` --
# but that routing only lands once <output> has been enumerated and given a logical
# position. Launch before then and the window has no positioned output to resolve
# its workspace against, so it collapses onto whatever's active.
#
# The precondition is therefore just "<output> exists with a logical position" --
# NOT "a named workspace already reports on <output>". Persistent named workspaces
# are declared in the config, but niri does not surface an empty one on its output
# until a window occupies it (or it's activated), so gating on that stalled here:
# on the primary output "terminal" is filled by *this* gated ghostty (chicken/egg)
# and "coding" only appears once Zed's slow cold start opens -- the poll could burn
# the entire ~30s budget and ghostty then arrived only via the degrade-fallback (or
# not at all). Gating on the output itself passes as soon as the monitor is up and
# lets the window-rules do the routing.
#
# Spawned via spawn-at-startup in the niri config, so it inherits the session's
# WAYLAND_DISPLAY and runs niri-session-only.
set -eu

output=$1
shift

# Diagnostic log (temporary): records what the gate saw each boot so a recurrence
# is self-documenting instead of needing another reboot to guess. Safe to delete.
log="${XDG_STATE_HOME:-$HOME/.local/state}/niri-startup.log"
now() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log_line() { printf '%s [%s pid=%s] %s\n' "$(now)" "$output" "$$" "$1" >>"$log" 2>/dev/null || true; }

log_line "start: waiting for output to be enumerated with a logical position"

# Bounded poll (~30s): don't hang the session forever on an unplugged output --
# after the budget, launch anyway so a missing monitor degrades gracefully.
tries=0
gated=timeout
while [ "$tries" -lt 150 ]; do
	# Normalise both possible shapes of `niri msg -j outputs` (object keyed by
	# connector, or a flat array) to an array of output objects, then require one
	# named <output> with a non-null logical position.
	if niri msg -j outputs |
		jq -e --arg o "$output" \
			'[.[]] | any(.[]; .name == $o and .logical != null)' \
			>/dev/null 2>&1; then
		gated=ready
		break
	fi
	tries=$((tries + 1))
	sleep 0.2
done

log_line "gate=$gated after ${tries} polls (~$((tries / 5))s)"
if [ "$gated" = timeout ]; then
	# Capture the state that failed the gate so the next boot's log explains it.
	log_line "outputs=$(niri msg -j outputs 2>/dev/null | jq -c '[.[]] | map({name,logical:(.logical!=null)})' 2>/dev/null || echo '?')"
	log_line "workspaces=$(niri msg -j workspaces 2>/dev/null | jq -c 'map({name,output})' 2>/dev/null || echo '?')"
fi

# List order == left-to-right column order: the gap lets each window open and
# take its column before the next launches. `|| true` so one failed launch
# doesn't abort the rest under `set -e`.
for cmd in "$@"; do
	log_line "launch: $cmd"
	setsid -f "$cmd" >/dev/null 2>&1 || true
	sleep 1.5
done
log_line "done"
